# ── Primary LLM: Azure OpenAI (Recommended for Enterprise) ─────────────
AZURE_OPENAI_API_KEY="your-azure-openai-key"
AZURE_OPENAI_ENDPOINT="https://your-instance.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="your-deployment-name"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"
AZURE_OPENAI_MODEL="gpt-4o-mini"

# ── Secondary LLMs (Fallbacks) ─────────────────────────────────────────

# NVIDIA NIM
NIM_API_KEY="your-nim-api-key"
NIM_MODEL="meta/llama-3.3-70b-instruct"
NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# Google Gemini
GOOGLE_API_KEY="your-google-api-key-1"
GOOGLE_API_KEY_2="your-google-api-key-2-optional"
GEMINI_MODEL="gemini-3.1-flash-lite-preview"

# Groq
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="qwen-qwq-32b"

# ── Agent Execution & Environment ──────────────────────────────────────
UV_PATH="uv"
UVX_PATH="uvx"

# ── Application Config ─────────────────────────────────────────────────
COURSE_DATA_PATH="/absolute/path/to/ScholarGen/Data/nptel_courses_with_embeddings.xlsx"
JWT_SECRET_KEY="generate-a-secure-random-key-for-production"
